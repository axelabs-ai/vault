+/// Parse the comma separated `SSO_ALLOWED_TENANT_IDS` value. Split out from
+/// `allowed_tenant_ids` so the tests can build an allow-list without CONFIG and still
+/// go through the same trimming/lowercasing the running server does.
+fn parse_tenant_ids(raw: &str) -> Vec<String> {
+    raw.split(',').map(|t| t.trim().to_lowercase()).filter(|t| !t.is_empty()).collect()
+}
+
+/// Comma separated allow-list of Entra tenant ids (`SSO_ALLOWED_TENANT_IDS`).
+/// Empty = feature off, issuer must match `SSO_AUTHORITY` exactly (previous behaviour).
+pub fn allowed_tenant_ids() -> Vec<String> {
+    parse_tenant_ids(&CONFIG.sso_allowed_tenant_ids())
+}
+
+/// Is this `iss` acceptable?
+///
+/// Exact match against `SSO_AUTHORITY` is always accepted — that is the single-tenant
+/// contract and stays untouched.
+///
+/// Multi-tenant is opt-in and *narrow*: Entra's `/organizations` and `/common`
+/// endpoints advertise a **templated** issuer (`.../{tenantid}/v2.0`) while real
+/// tokens carry the concrete tenant guid, so a strict comparison can never match and
+/// every login fails. We accept such a token only when its tenant id is in the
+/// operator's allow-list. The allow-list is mandatory by construction: with it empty
+/// this function degrades to the exact match above, so enabling the multi-tenant
+/// endpoint without naming tenants does not silently admit every Entra tenant on the
+/// internet.
+pub fn issuer_is_accepted(iss: &str) -> bool {
+    issuer_matches(&CONFIG.sso_authority(), &allowed_tenant_ids(), iss)
+}
+
+/// The decision itself, with no CONFIG in it. `issuer_is_accepted` is the thin wrapper that
+/// supplies the configured values; the tests call this directly so they exercise the code
+/// that ships rather than a copy of its rules.
+fn issuer_matches(authority: &str, allowed: &[String], iss: &str) -> bool {
+    if iss == authority {
+        return true;
+    }
+    if allowed.is_empty() {
+        return false;
+    }
+    // Only rewrite the tenant segment of the configured authority — everything else
+    // (scheme, host, version suffix) must still match, so this cannot be used to
+    // accept an issuer from some other identity provider entirely.
+    let Some((prefix, suffix)) = split_multi_tenant_authority(authority) else {
+        return false;
+    };
+    let Some(rest) = iss.strip_prefix(&prefix) else {
+        return false;
+    };
+    let Some(tenant) = rest.strip_suffix(&suffix) else {
+        return false;
+    };
+    !tenant.is_empty() && !tenant.contains('/') && allowed.contains(&tenant.to_lowercase())
+}
+
+/// Split `https://host/{organizations|common}/v2.0` into the parts around the tenant
+/// segment. `None` when the authority is not a multi-tenant endpoint.
+fn split_multi_tenant_authority(authority: &str) -> Option<(String, String)> {
+    for marker in ["/organizations", "/common"] {
+        if let Some(idx) = authority.rfind(marker) {
+            let prefix = format!("{}/", &authority[..idx]);
+            let suffix = authority[idx + marker.len()..].to_string();
+            return Some((prefix, suffix));
+        }
+    }
+    None
+}
