+    fn tenant_substitution_cannot_reach_another_provider() {
+        // 목록에 있어도 호스트가 다르면 거부 — 접두/접미가 함께 일치해야 한다.
+        assert!(!with(ORGS, "evil", "https://evil.example.com/evil/v2.0"));
+        // 경로 주입으로 접미사를 맞추려는 시도.
+        assert!(!with(ORGS, "a", "https://login.microsoftonline.com/a/b/v2.0"));
+    }
+
+    #[test]
+    fn lookalike_authorities_are_not_multi_tenant() {
+        // authority 자체가 위장인 경우 — substring 스캔이면 전부 Some 을 줬다.
+        // 타 IdP 의 realm 이름이 우연히(또는 고의로) `common` 인 경우.
+        const KEYCLOAK: &str = "https://keycloak.example.com/realms/common/v2.0";
+        // 진짜 Entra 호스트지만 테넌트 이름이 `common…` 으로 시작하는 경우.
+        const LOOKALIKE: &str = "https://login.microsoftonline.com/commonality/v2.0";
+        // 경로가 더 붙은 경우.
+        const DEEPER: &str = "https://login.microsoftonline.com/common/v2.0/extra";
+        // 호스트를 접미사로 삼아 붙인 경우.
+        const EVIL_HOST: &str = "https://login.microsoftonline.com.evil.example/common/v2.0";
+
+        for authority in [KEYCLOAK, LOOKALIKE, DEEPER, EVIL_HOST] {
+            assert_eq!(split_multi_tenant_authority(authority), None, "{authority} 는 멀티테넌트가 아니다");
+            // 그러므로 그 authority 로는 어떤 iss 도 치환 통과할 수 없다 — 정확 일치만 남는다.
+            assert!(!with(authority, "381cc823-2bb2-43a7-9a27-68ea3afacdff", RC));
