+#[cfg(test)]
+mod axe_issuer_tests {
+    // `issuer_is_accepted` 는 인증 경계다. 여기서 고정하는 성질은 세 가지:
+    //   1. 허용목록이 비면 **종전 동작**(정확 일치)으로 남는다 — 회귀 없음
+    //   2. 멀티테넌트 엔드포인트라도 목록에 없는 테넌트는 거부 — 켜는 것이 곧 개방이 아니다
+    //   3. 테넌트 자리만 치환한다 — 다른 IdP 의 issuer 를 통과시키는 데 쓸 수 없다
+    use super::*;
+
+    /// `issuer_is_accepted` 에서 CONFIG 두 값을 빼면 남는 것이 `issuer_matches` 다.
+    /// 여기서는 그 둘을 인자로 넣어줄 뿐, 판정 규칙은 한 줄도 다시 쓰지 않는다 —
+    /// 규칙을 복제하면 테스트는 사본을 통과시키고 배포본은 틀릴 수 있다.
+    fn with(authority: &str, allowed: &str, iss: &str) -> bool {
+        issuer_matches(authority, &parse_tenant_ids(allowed), iss)
+    }
+
+    const AXE: &str = "https://login.microsoftonline.com/122fb574-7efa-476a-95b6-bee81bce2cce/v2.0";
+    const ORGS: &str = "https://login.microsoftonline.com/organizations/v2.0";
+    const RC: &str = "https://login.microsoftonline.com/381cc823-2bb2-43a7-9a27-68ea3afacdff/v2.0";
+
+    #[test]
+    fn empty_allowlist_keeps_strict_single_issuer() {
+        assert!(with(AXE, "", AXE));
+        assert!(!with(AXE, "", RC));
+        // 멀티테넌트 authority 라도 목록이 비면 아무도 못 들어온다.
+        assert!(!with(ORGS, "", RC));
+    }
+
+    #[test]
+    fn listed_tenant_passes_on_a_multi_tenant_authority() {
+        assert!(with(ORGS, "381cc823-2bb2-43a7-9a27-68ea3afacdff", RC));
+        assert!(with(ORGS, "122fb574-7efa-476a-95b6-bee81bce2cce, 381cc823-2bb2-43a7-9a27-68ea3afacdff", AXE));
+    }
+
+    #[test]
+    fn unlisted_tenant_is_rejected() {
+        assert!(!with(ORGS, "122fb574-7efa-476a-95b6-bee81bce2cce", RC));
+    }
+
+    #[test]
+    fn tenant_substitution_cannot_reach_another_provider() {
+        // 목록에 있어도 호스트가 다르면 거부 — 접두/접미가 함께 일치해야 한다.
+        assert!(!with(ORGS, "evil", "https://evil.example.com/evil/v2.0"));
+        // 경로 주입으로 접미사를 맞추려는 시도.
+        assert!(!with(ORGS, "a", "https://login.microsoftonline.com/a/b/v2.0"));
+    }
+}
