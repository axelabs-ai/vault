+        );
+        assert_eq!(
+            split_multi_tenant_authority("https://login.microsoftonline.com/common/v2.0"),
+            split_multi_tenant_authority(ORGS)
+        );
+        // query·fragment 가 붙으면 우리가 아는 엔드포인트가 아니다.
+        assert_eq!(split_multi_tenant_authority(&format!("{ORGS}?x=1")), None);
+        assert_eq!(split_multi_tenant_authority(&format!("{ORGS}#x")), None);
+        // http 다운그레이드·명시 포트도 거부.
+        assert_eq!(split_multi_tenant_authority("http://login.microsoftonline.com/common/v2.0"), None);
+        assert_eq!(split_multi_tenant_authority("https://login.microsoftonline.com:8443/common/v2.0"), None);
+    }
