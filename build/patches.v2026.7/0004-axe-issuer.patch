+#[cfg(test)]
+mod axe_discovery_tests {
+    // 디스커버리 URL 은 `{authority}/.well-known/openid-configuration` 이어야 한다.
+    // `Url::join` 류의 상대참조 해석은 trailing slash 없는 base 의 마지막 세그먼트를
+    // **교체**하므로 `/organizations/v2.0` 이 `/organizations` 가 되어 Entra **v1**
+    // 메타데이터를 받는다 — 로그인은 되는데 issuer 가 다른, 진단이 어려운 회귀다.
+    use super::*;
+
+    #[test]
+    fn multi_tenant_authorities_keep_their_v2_segment() {
+        assert_eq!(
+            discovery_url("https://login.microsoftonline.com/organizations/v2.0"),
+            "https://login.microsoftonline.com/organizations/v2.0/.well-known/openid-configuration"
+        );
+        assert_eq!(
+            discovery_url("https://login.microsoftonline.com/common/v2.0"),
+            "https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration"
+        );
+    }
+
+    #[test]
+    fn single_tenant_authority_and_trailing_slash_agree() {
+        const TENANT: &str = "https://login.microsoftonline.com/122fb574-7efa-476a-95b6-bee81bce2cce/v2.0";
+        assert_eq!(
+            discovery_url(TENANT),
+            "https://login.microsoftonline.com/122fb574-7efa-476a-95b6-bee81bce2cce/v2.0/.well-known/openid-configuration"
+        );
+        // 설정에 슬래시가 붙어 와도 `//` 가 생기지 않는다.
+        assert_eq!(discovery_url(&format!("{TENANT}/")), discovery_url(TENANT));
+    }
+}
