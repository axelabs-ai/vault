+/// `<issuer>/.well-known/openid-configuration`, built by **appending** the suffix.
+///
+/// Deliberately not `Url::join`: RFC 3986 relative resolution treats the last segment of a
+/// base without a trailing slash as a file and replaces it, which would turn the authority
+/// `https://login.microsoftonline.com/organizations/v2.0` into a **v1** metadata URL. (The
+/// crate's own `IssuerUrl::join` happens to concatenate rather than resolve, but nothing in
+/// its name says so — this spells it out, and the tests below pin it.)
+fn discovery_url(issuer: &str) -> String {
+    format!("{}/.well-known/openid-configuration", issuer.trim_end_matches('/'))
+}
+
+/// Fetch `<issuer>/.well-known/openid-configuration` **and the JWKS it advertises**, binding
+/// the document to `expected_issuer` instead of to the requested URL.
+///
+/// Only reachable for an Entra `/organizations` or `/common` authority with a tenant
+/// allow-list set (see the call site). Those documents name their issuer with the literal
+/// `{tenantid}` placeholder, so the crate's `metadata.issuer == issuer_url` assertion is
+/// structurally unsatisfiable — but "unsatisfiable" is not "droppable": we still demand an
+/// exact string match, against the template that the same authority parsing derives. Without
+/// it the bypass would accept any document served at that URL, and since the id_token
+/// signatures are verified with keys from *this* document, the later `issuer_is_accepted`
+/// check on token claims would not be an equivalent binding.
+///
+/// Discovery is **two** fetches, not one. `ProviderMetadata.jwks` carries `#[serde(skip)]`,
+/// so deserializing the document can never populate the signing keys — `discover_async`
+/// fills them by fetching `jwks_uri` afterwards. Dropping that second fetch builds a client
+/// with zero keys and turns every login into `Signature verification failed`, which is
+/// exactly the 2026-08-11 production SSO outage.
+async fn fetch_provider_metadata_unchecked(
+    issuer_url: &openidconnect::IssuerUrl,
+    expected_issuer: &str,
+    http_client: &OidcHttpClient,
+) -> Result<CoreProviderMetadata, String> {
+    // The same transport as every other OIDC call. A bare `reqwest::get` would spin up the
+    // default client and silently opt out of our timeouts, proxy and TLS policy here alone.
+    let url = discovery_url(issuer_url.as_str());
+    let request = http::Request::builder()
+        .uri(&url)
+        .method(http::Method::GET)
+        .header(http::header::ACCEPT, http::HeaderValue::from_static("application/json"))
+        .body(Vec::new())
+        .map_err(|e| format!("GET {url}: {e}"))?;
+    let resp = match http_client.call(request).await {
+        Ok(r) => r,
+        Err(e) => return Err(format!("GET {url}: {e}")),
+    };
+    if !resp.status().is_success() {
+        return Err(format!("GET {url}: HTTP {}", resp.status()));
+    }
+    let metadata =
+        serde_json::from_slice::<CoreProviderMetadata>(resp.body()).map_err(|e| format!("parse {url}: {e}"))?;
+
+    // This replaces the assertion we skipped. `IssuerUrl` keeps the string it was given, so
+    // the literal `{tenantid}` survives here un-encoded and an exact comparison is meaningful.
+    if metadata.issuer().as_str() != expected_issuer {
+        return Err(format!("{url}: issuer is {}, expected {expected_issuer}", metadata.issuer().as_str()));
+    }
+
+    // Second fetch — the same call `discover_async` makes once it has the document. Reuse the
+    // crate's own fetcher so the keys are parsed exactly as upstream parses them.
+    let jwks_uri = metadata.jwks_uri().clone();
+    let jwks = match CoreJsonWebKeySet::fetch_async(&jwks_uri, http_client).await {
+        Ok(jwks) => jwks,
+        Err(e) => return Err(format!("GET {jwks_uri}: {e}")),
+    };
+    // A key set that verifies nothing must fail loudly here, not as an opaque
+    // "Signature verification failed" on every subsequent login.
+    if jwks.keys().is_empty() {
+        return Err(format!("GET {jwks_uri}: 0 signing keys — refusing to build a client that cannot verify"));
+    }
+
+    Ok(metadata.set_jwks(jwks))
+}
