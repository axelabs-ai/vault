-        let provider_metadata = match CoreProviderMetadata::discover_async(issuer_url, &http_client).await {
-            Err(err) => err!(format!("Failed to discover OpenID provider: {err}")),
-            Ok(metadata) => metadata,
+        // `discover_async` asserts `metadata.issuer == issuer_url`. Entra's multi-tenant
+        // endpoints publish the issuer as the literal template
+        // `https://login.microsoftonline.com/{tenantid}/v2.0`, so that assert can never
+        // hold and discovery 400s before any user is even redirected — which is exactly
+        // what happened on 2026-08-10 when only the token-side checks had been patched.
+        //
+        // With a tenant allow-list configured we run discovery ourselves — document fetch,
+        // deserialize (the crate only compares inside `discover_async`, not in `Deserialize`),
+        // then the JWKS fetch that `discover_async` would have done. This is NOT a weakening:
+        // the templated issuer is unusable for verification anyway, and `issuer_is_accepted`
+        // re-checks the concrete `iss` of every token against the allow-list afterwards.
+        let provider_metadata = if crate::sso::allowed_tenant_ids().is_empty() {
+            match CoreProviderMetadata::discover_async(issuer_url, &http_client).await {
+                Err(err) => err!(format!("Failed to discover OpenID provider: {err}")),
+                Ok(metadata) => metadata,
+            }
+        } else {
+            match fetch_provider_metadata_unchecked(&issuer_url, &http_client).await {
+                Err(err) => err!(format!("Failed to fetch OpenID provider metadata: {err}")),
+                Ok(metadata) => metadata,
+            }
         };
 
         let auth_methods: Option<HashSet<CoreClientAuthMethod>> = provider_metadata
