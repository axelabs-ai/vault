+/// The issuer a multi-tenant Entra authority advertises in its own discovery document:
+/// the configured authority with the tenant segment replaced by Entra's **literal**
+/// `{tenantid}` placeholder (it really is those nine characters in the JSON, not a value).
+///
+/// `None` when the authority is not one of Entra's multi-tenant endpoints — which is also
+/// the signal that the discovery bypass in `sso_client` must stay off, since there is then
+/// no template to bind the document to and no reason to skip the crate's own check.
+pub fn multi_tenant_issuer_template(authority: &str) -> Option<String> {
+    let (prefix, suffix) = split_multi_tenant_authority(authority)?;
+    Some(format!("{prefix}{{tenantid}}{suffix}"))
+}
