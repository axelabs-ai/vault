-            Ok(metadata) => metadata,
+        // `discover_async` asserts `metadata.issuer == issuer_url`. Entra's multi-tenant
+        // endpoints publish the issuer as the literal template
+        // `https://login.microsoftonline.com/{tenantid}/v2.0`, so that assert can never
+        // hold and discovery 400s before any user is even redirected — which is exactly
+        // what happened on 2026-08-10 when only the token-side checks had been patched.
+        //
+        // Two conditions gate the bypass, and both must hold:
+        //   1. the operator named tenants (`SSO_ALLOWED_TENANT_IDS` non-empty), and
+        //   2. the authority really is one of Entra's multi-tenant endpoints, i.e. it has a
+        //      `{tenantid}` template to bind the document to.
+        // An allow-list alone must not disable the crate's issuer binding for some unrelated
+        // authority (Google, Keycloak, a single-tenant Entra tenant) — those keep
+        // `discover_async` untouched.
+        let issuer_template = if crate::sso::allowed_tenant_ids().is_empty() {
+            None
+        } else {
+            crate::sso::multi_tenant_issuer_template(&CONFIG.sso_authority())
+        };
+
+        let provider_metadata = match issuer_template {
+            None => match CoreProviderMetadata::discover_async(issuer_url, &http_client).await {
+                Err(err) => err!(format!("Failed to discover OpenID provider: {err}")),
+                Ok(metadata) => metadata,
+            },
+            // We run discovery ourselves — document fetch, deserialize (the crate only compares
+            // inside `discover_async`, not in `Deserialize`), issuer bound to the template, then
+            // the JWKS fetch `discover_async` would have done. Not a weakening: the URL-equality
+            // assert is swapped for template equality, and `issuer_is_accepted` still re-checks
+            // the concrete `iss` of every token against the allow-list afterwards.
+            Some(expected_issuer) => {
+                match fetch_provider_metadata_unchecked(&issuer_url, &expected_issuer, &http_client).await {
+                    Err(err) => err!(format!("Failed to fetch OpenID provider metadata: {err}")),
+                    Ok(metadata) => metadata,
+                }
+            }
         };
 
         let auth_methods: Option<HashSet<CoreClientAuthMethod>> = provider_metadata
@@ -407,3 +513,35 @@ impl<'a, AD: AuthDisplay, P: AuthPrompt, RT: ResponseType> AuthorizationRequestE
         self
     }
 }
