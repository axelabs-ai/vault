+/// Fetch `<issuer>/.well-known/openid-configuration` **and the JWKS it advertises**, without
+/// the crate's `metadata.issuer == issuer_url` assertion.
+///
+/// Only reachable when `SSO_ALLOWED_TENANT_IDS` is set (see the call site). Entra's
+/// `/organizations` and `/common` documents name their issuer with a `{tenantid}`
+/// placeholder, so the assertion is structurally unsatisfiable there — skipping it is
+/// the only way to use those endpoints at all. Token issuers are still constrained,
+/// just later and more precisely, by `sso::issuer_is_accepted`.
+///
+/// Discovery is **two** fetches, not one. `ProviderMetadata.jwks` carries `#[serde(skip)]`,
+/// so deserializing the document can never populate the signing keys — `discover_async`
+/// fills them by fetching `jwks_uri` afterwards. Dropping that second fetch builds a client
+/// with zero keys and turns every login into `Signature verification failed`, which is
+/// exactly the 2026-08-11 production SSO outage.
+async fn fetch_provider_metadata_unchecked(
+    issuer_url: &openidconnect::IssuerUrl,
+    http_client: &OidcHttpClient,
+) -> Result<CoreProviderMetadata, String> {
+    // Same URL the crate builds (`IssuerUrl::join`), and — importantly — the same transport
+    // as every other OIDC call. A bare `reqwest::get` would spin up the default client and
+    // silently opt out of our timeouts, proxy and TLS policy for this one request.
+    let url = issuer_url
+        .join(".well-known/openid-configuration")
+        .map_err(|e| format!("build discovery url for {}: {e}", issuer_url.as_str()))?;
+    let request = http::Request::builder()
+        .uri(url.to_string())
+        .method(http::Method::GET)
+        .header(http::header::ACCEPT, http::HeaderValue::from_static("application/json"))
+        .body(Vec::new())
+        .map_err(|e| format!("GET {url}: {e}"))?;
+    let resp = match http_client.call(request).await {
+        Ok(r) => r,
+        Err(e) => return Err(format!("GET {url}: {e}")),
+    };
+    if !resp.status().is_success() {
+        return Err(format!("GET {url}: HTTP {}", resp.status()));
+    }
+    let metadata =
+        serde_json::from_slice::<CoreProviderMetadata>(resp.body()).map_err(|e| format!("parse {url}: {e}"))?;
+
+    // Second fetch — the same call `discover_async` makes once it has the document. Reuse the
+    // crate's own fetcher so the keys are parsed exactly as upstream parses them.
+    let jwks_uri = metadata.jwks_uri().clone();
+    let jwks = match CoreJsonWebKeySet::fetch_async(&jwks_uri, http_client).await {
+        Ok(jwks) => jwks,
+        Err(e) => return Err(format!("GET {jwks_uri}: {e}")),
+    };
+    // A key set that verifies nothing must fail loudly here, not as an opaque
+    // "Signature verification failed" on every subsequent login.
+    if jwks.keys().is_empty() {
+        return Err(format!("GET {jwks_uri}: 0 signing keys — refusing to build a client that cannot verify"));
+    }
+
+    Ok(metadata.set_jwks(jwks))
+}
+
 impl Client {
     // Call the OpenId discovery endpoint to retrieve configuration
     async fn get_client() -> ApiResult<Self> {
@@ -161,9 +217,27 @@ impl Client {
             Ok(client) => client,
