{
  "name": "axe-vault-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AXE Vault 웹 클라이언트 (B-vault-axe-frontend P1) — Bitwarden 공식 WASM 크립토 + @axe/ui 3-zone 워크스페이스",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.mjs\"",
    "axe-ui:sync": "node ../../axelabs/scripts/export-axe-ui.mjs --config axe-ui.consumer.json --provider-commit \"$(git -C ../../axelabs rev-parse HEAD)\"",
    "axe-ui:check": "node ../../axelabs/scripts/export-axe-ui.mjs --config axe-ui.consumer.json --provider-commit \"$(git -C ../../axelabs rev-parse HEAD)\" --check"
  },
  "dependencies": {
    "@bitwarden/sdk-internal": "0.2.0-main.967",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vite-plugin-wasm": "3.5.0"
  }
}
